// FitNexus — Prisma schema
// Scope for now: organization (tenant) + owner account + OTP-based
// registration/login/password-reset, matching the Angular auth flows.
// Branch/member/plan models get added as those modules are built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: the transaction pooler — what the running app uses
  // at request time (pgbouncer=true, so Prisma disables prepared
  // statements — required for correctness under transaction pooling).
  url       = env("DATABASE_URL")
  // DIRECT_URL: the session pooler (or a true direct connection) — only
  // `prisma migrate`/`db push` use this. Transaction-mode pooling
  // doesn't support the session-level advisory locks migrations need,
  // which is why running migrate against DATABASE_URL alone just hangs
  // instead of failing outright.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  BRANCH_MANAGER
  TRAINER
  FRONT_DESK
  STAFF
  MEMBER
}

// One row per screen the app has (or will have) — used as the Screen
// axis of the RolePermission matrix. New screens get a new value here
// plus a seeded row per role; nothing else needs to change to support
// them ahead of time (same "build inert" pattern as NotificationType).
enum Screen {
  DASHBOARD
  EMPLOYEES
  ATTENDANCE
  LEADS
  NOTIFICATIONS
  BRANCHES
  MEMBERS
  PLANS
  EXPENSES
  // Governs the approval/management side of leave — reviewing and
  // deciding a team's leave requests, and configuring monthly
  // allocation. Applying for one's own leave and viewing one's own
  // balance is a self-service action available to every employee
  // regardless of this permission (see LeaveController) — same
  // pattern as DASHBOARD being universally readable.
  LEAVES
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  EQUIPMENT
  MAINTENANCE
  MARKETING
  OTHER
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

enum OtpChannel {
  EMAIL
  PHONE
}

enum OrganizationStatus {
  ACTIVE
  NOT_ACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

// Purely to pick which body-shape preset the progress avatar renders
// with (see MemberMetricEntry) — OTHER falls back to a neutral preset.
// Not used anywhere else.
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PlanDuration {
  MONTHLY
  QUARTERLY
  ANNUAL
  CLASS_PACK
  DROP_IN
}

// Offer types configurable per plan. Definitions only for now (same as
// MembershipPlan) — applying one to an actual member signup happens once
// the Members module exists.
//   PERCENT_DISCOUNT - percentValue % off the plan price
//   FLAT_DISCOUNT    - flatAmount off the plan price, in the branch's currency
//   EXTRA_DURATION   - extraMonths added free on top of the plan's duration
//   COUPLE           - percentValue % off a second member's plan price
//                      when both are added together (100 = second member free)
enum OfferType {
  PERCENT_DISCOUNT
  FLAT_DISCOUNT
  EXTRA_DURATION
  COUPLE
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL_SCHEDULED
  TRIAL_COMPLETED
  CONVERTED
  LOST
}

enum EmployeeRole {
  MANAGER
  TRAINER
  FRONT_DESK
  OTHER
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  // Unique, auto-generated id (cuid — collision-resistant, sortable,
  // no external call needed unlike uuid-in-app-code).
  id String @id @default(cuid())

  // Full organization details, captured at registration time.
  name      String // organization name
  ownerName String
  email     String
  phone     String

  // NOT_ACTIVE until the owner verifies both email and phone OTPs
  // (see AuthService.verifyRegisterOtp); an admin can also flip this
  // to NOT_ACTIVE later to suspend an organization.
  status OrganizationStatus @default(NOT_ACTIVE)

  // Explicit created/updated timestamps — createdAt is set once at
  // insert time and never changes; updatedAt is bumped by Prisma on
  // every update (e.g. when status flips to ACTIVE).
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  branches  Branch[]
  leads     Lead[]
  employees Employee[]
  plans     MembershipPlan[]
  offers    Offer[]
  members   Member[]
  expenses  Expense[]
  leaveAllocationConfigs LeaveAllocationConfig[]
  leaveBalances          LeaveBalance[]
  leaveRequests          LeaveRequest[]
  biometricDevices      BiometricDevice[]
  attendancePunches     AttendancePunch[]
  attendanceDayRecords  AttendanceDayRecord[]
  holidays              Holiday[]
  alerts                Alert[]

  notifications        Notification[]
  notificationSetup    NotificationSetup?
  notificationConfigs  NotificationConfig[]
  rolePermissions      RolePermission[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Location IS the branch's identifying field now — there's no separate
  // name, and no separate city/state/country columns either. It's a
  // short single-line label for where the branch is (e.g. "Anna Nagar,
  // Chennai") — mandatory, entered in a plain input box, and unique per
  // organization. Full address detail belongs in `address` below, not
  // here.
  location String

  // Free-text detail (full street address, landmark, floor/unit,
  // directions, etc.) — entered in a multi-line textarea, fully
  // separate from location, always optional.
  address String?
  phone   String?
  email   String?

  // Branch-wise settings — every branch operates independently for
  // pricing/compliance per the product spec (cross-branch plans are
  // composed from these, not priced separately at the chain level).
  // Timezone has no dedicated input — it just defaults to UTC and can
  // be corrected later if a per-branch value is ever needed.
  timezone        String  @default("UTC")
  currency        String  @default("INR") // ISO 4217 code
  taxRatePercent  Decimal @db.Decimal(5, 2)
  defaultLanguage String  @default("en")

  status BranchStatus @default(ACTIVE)

  // The org's first branch is always the main branch automatically (no
  // prompt needed). For every branch after that, the owner can opt in
  // via a checkbox — setting one main branch unsets whichever branch
  // held it before, enforced in BranchesService, not at the DB level.
  isMainBranch Boolean @default(false)

  // Manually entered for now (no Members module yet) — feeds the
  // upcoming branch+member-based subscription pricing calculation.
  // Mandatory at entry (validated in the DTO); no default here since
  // every branch should have a deliberate value, not a silent 0.
  memberCount Int

  leads     Lead[]
  employees Employee[]
  staff     User[]
  plans     MembershipPlan[]
  members   Member[]
  expenses  Expense[]
  leaveRequests          LeaveRequest[]
  alertsTargeted         Alert[]           @relation("AlertAudienceBranch")
  biometricDevices       BiometricDevice[]
  attendancePunches      AttendancePunch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The same location text can't be used twice within an organization —
  // address is deliberately NOT part of this uniqueness check, since
  // it's just free-text extra detail, not what identifies "the same
  // place". The service layer also runs a case-insensitive/trimmed
  // pre-check so a duplicate gets a friendly error before this
  // constraint would otherwise reject it outright.
  @@unique([organizationId, location], name: "branches_org_location_unique")
  @@map("branches")
}

// Branch-wise plan definitions (spec section 4) — each branch defines its
// own plans with their own price, in the branch's own currency (there's
// no separate currency field here; display always reads Branch.currency,
// same as how a branch's tax rate/timezone work). First pass: definitions
// only — no Stripe billing and no member assignment yet, both of which
// need the Members module to exist first.
model MembershipPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name     String
  price    Decimal      @db.Decimal(10, 2)
  duration PlanDuration

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A branch can't have two plans with the same name — same
  // case-insensitive pre-check pattern as Branch.location (see
  // PlansService.assertUniqueName).
  @@unique([branchId, name], name: "plans_branch_name_unique")
  @@map("membership_plans")

  members Member[]
}

// Independent, org-wide discount/promo catalog — like a coupon: not tied
// to any single plan or branch. Any offer can be applied to any plan for
// any branch when a member signs up (that step lives in the Members
// module, not built yet). A FLAT_DISCOUNT's amount has no currency of
// its own — it's interpreted in whichever branch's/plan's currency it
// gets applied against at that time.
model Offer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String
  type OfferType

  // PERCENT_DISCOUNT / COUPLE only.
  percentValue Decimal? @db.Decimal(5, 2)

  // FLAT_DISCOUNT only — see the currency note above.
  flatAmount Decimal? @db.Decimal(10, 2)

  // EXTRA_DURATION only.
  extraMonths Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offers")

  members Member[]
}

// Member Management (spec section 4) first pass: core record + plan/offer
// assignment. No photo, no emergency contact, no cross-branch access, no
// Stripe billing, no freeze/hold yet — same "definitions/core record
// first" approach used for Plans and Offers.
//
// startDate is the only date entered directly; endDate is always
// computed (never typed) from the plan's duration plus any extra months
// from an EXTRA_DURATION offer, recalculated whenever startDate/plan/
// offer changes (see MembersService). price is likewise a snapshot of
// what was actually charged (plan price adjusted by whichever offer
// applied) — set once at signup and never recomputed from a later plan
// price change, so a member's own record stays historically accurate.
//
// A COUPLE offer pairs two members: the secondary (discounted) member
// stores partnerMemberId pointing at the primary (full-price) member it
// was created alongside.
model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Home branch — a member belongs to exactly one branch (no
  // cross-branch access in this first pass).
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?

  // Free-text (Walk-in, Referral, Converted from Lead, ...) — shared
  // frontend constant, same pattern as Lead.source.
  source String?

  // Required — every member is on some plan; the plan must belong to
  // this member's branch (validated in MembersService). SetNull (not
  // Cascade) so deleting a plan doesn't delete its members' historical
  // records — planId just goes null and the snapshot fields below still
  // tell the full story.
  planId String?
  plan   MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  // Optional — from the independent, org-wide Offer catalog. SetNull
  // for the same reason as planId.
  offerId String?
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  // Optional — must belong to this member's branch (validated in
  // MembersService). SetNull so deleting the employee doesn't delete
  // the member, it just clears the assignment (same pattern as
  // Lead.assignedToEmployee).
  assignedTrainerEmployeeId String?
  assignedTrainerEmployee   Employee? @relation(fields: [assignedTrainerEmployeeId], references: [id], onDelete: SetNull)

  preferredLanguage String  @default("en")
  // Free-text (Cash, Card, UPI, ...) — shared frontend constant.
  paymentMode       String?

  // Marker only — doesn't change price/duration math. Lets trial
  // members be filtered for follow-up once notifications extend here.
  isTrial Boolean @default(false)

  startDate DateTime
  endDate   DateTime

  // Snapshot of what was actually charged — see the doc comment above.
  price Decimal @db.Decimal(10, 2)

  status MemberStatus @default(ACTIVE)

  // Set only on the secondary member of a COUPLE-offer pairing; points
  // at the primary (full-price) member it was created alongside.
  partnerMemberId String? @unique
  partnerMember   Member? @relation("MemberPartner", fields: [partnerMemberId], references: [id], onDelete: SetNull)
  partneredBy     Member? @relation("MemberPartner")

  // Health profile — all optional so existing members aren't forced to
  // fill these in immediately. Age is always computed from dateOfBirth,
  // never stored. heightCm is kept at the member level (rarely changes
  // for an adult) rather than snapshotted per metric entry; a metric
  // entry's bmi is computed from whatever heightCm is current *at the
  // time that entry is recorded* and then frozen on the entry itself, so
  // editing height later doesn't rewrite history (see MembersService).
  dateOfBirth  DateTime?
  gender       Gender?
  bloodGroup   String?
  heightCm     Decimal?  @db.Decimal(5, 2)
  goalWeightKg Decimal?  @db.Decimal(5, 2)

  metricEntries MemberMetricEntry[]
  biometricEnrollments BiometricEnrollment[]
  attendancePunches    AttendancePunch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, branchId])
  @@map("members")
}

// One row per monthly (or whenever-recorded) check-in — weight and tape
// measurements, plus a BMI computed from that weight against the
// member's heightCm *at the time this entry was created* and frozen
// here (bmi/bmiStatus), so a later height correction never rewrites
// past history. bmiStatus is the standard WHO band name
// (UNDERWEIGHT/NORMAL/OVERWEIGHT/OBESE), stored as plain text rather
// than a DB enum since it's derived/display data, not a business state
// machine like MemberStatus. Feeds both the history list/chart and the
// progress-avatar preset on the Members screen.
model MemberMetricEntry {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  recordedAt DateTime @default(now())

  weightKg Decimal  @db.Decimal(5, 2)
  chestCm  Decimal? @db.Decimal(5, 2)
  waistCm  Decimal? @db.Decimal(5, 2)
  hipsCm   Decimal? @db.Decimal(5, 2)

  bmi       Decimal @db.Decimal(4, 1)
  bmiStatus String

  // A progress photo for this check-in, stored as a base64 data URL
  // (client-side compressed before upload — see members.ts) rather than
  // a file-storage URL, since there's no object storage wired up yet.
  // Optional — a member can log numbers without a photo.
  photoUrl String?

  createdAt DateTime @default(now())

  @@index([memberId, recordedAt])
  @@map("member_metric_entries")
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Which branch this lead is interested in — leads are tracked
  // chain-wide (owners see all of them) but each one belongs to exactly
  // one branch, matching the branch-scoped-by-default model everything
  // else in the product follows.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?

  // Free-text options (Walk-in, Referral, Instagram, ...) maintained as
  // a shared frontend constant rather than a DB enum — same pattern as
  // Branch.currency, so the list can change without a migration.
  source String?

  interestedPlan String?

  // Real link to an Employee record (Employees module shipped after this
  // field was originally free text — see git history). Nullable/SetNull
  // so deleting the employee doesn't delete the lead, it just clears the
  // assignment.
  assignedToEmployeeId String?
  assignedToEmployee   Employee? @relation(fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)

  // Who created this lead — set once, at creation, from the JWT. Staff
  // (Trainer/Manager/Front Desk) only ever see leads they personally
  // created (see LeadsService.findAll); the owner sees everything.
  // Nullable/SetNull so deleting the user doesn't delete the lead.
  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  status     LeadStatus @default(NEW)
  // Only meaningful when status is LOST — the service enforces this is
  // present when a lead is marked lost, and logs it as a timeline entry.
  lostReason String?
  // Only meaningful when status is CONVERTED — the "Conclude" checkbox's
  // comment for the converted outcome (lostReason plays the same role
  // for the LOST outcome). Service enforces this is present when a lead
  // is concluded as converted, and logs it as a timeline entry.
  concludeComment String?

  // Date + time, not just a date — drives the overdue-follow-up badge
  // on the card/list with time-of-day precision.
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]

  @@map("leads")
}

model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Manually logged follow-up notes are the only thing that populates a
  // lead's timeline in this pass (no auto-logging of every field edit),
  // except moving a lead to LOST also drops one of these carrying the
  // lost reason — see LeadsService.update.
  note String

  // The follow-up date/time set at the moment this note was logged —
  // kept on the activity itself (not just on the Lead) so the timeline
  // shows what was scheduled at each point in history, not only the
  // lead's current value. When present, LeadsService.addActivity also
  // copies it onto Lead.nextFollowUpAt so the overdue badge tracks it.
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model Employee {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Single-branch only for now (the spec allows multi-branch staff, but
  // that's deferred until there's an actual need for it).
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String
  photoUrl String?

  role   EmployeeRole @default(OTHER)
  status EmploymentStatus @default(ACTIVE)

  joinDate    DateTime
  // Feeds the (currently inert) BIRTHDAY_EMPLOYEE notification type once
  // its cron check is wired up.
  dateOfBirth DateTime?

  // Optional — plain numeric monthly pay, no currency conversion logic
  // here (branch already carries its own currency for display).
  basicPay Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities EmployeeActivity[]

  // Set once a login is created for this employee (via the "Create
  // login" checkbox on creation, or the retroactive action for older
  // records) — null means this employee has no login yet.
  user User?

  // Leads assigned to this employee via Lead.assignedToEmployeeId.
  assignedLeads Lead[]

  // Members this employee is the assigned trainer for.
  assignedMembers Member[]

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  biometricEnrollments BiometricEnrollment[]
  attendancePunches    AttendancePunch[]
  attendanceDayRecords AttendanceDayRecord[]

  @@index([organizationId, branchId])
  @@map("employees")
}

model EmployeeActivity {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  note String

  createdAt DateTime @default(now())

  @@index([employeeId, createdAt])
  @@map("employee_activities")
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role     UserRole @default(OWNER)
  name     String
  email    String   @unique
  phone    String   @unique
  password String // bcrypt hash — used for the actual login check

  // Reversibly encrypted (AES-256-GCM, see credentials-crypto.util.ts)
  // copy of the plaintext password — set only for auto-generated staff
  // logins, so the owner can look it up again from the employee's
  // detail screen. Null for the owner's own account (set via the
  // register flow, never auto-generated) and for any login created
  // before this field existed.
  passwordEnc String?

  // Set for staff logins (Trainer/Manager/Front Desk) — null for the
  // owner's own account. Scopes a staff member's data access to just
  // this branch (see BranchScopeGuard); the owner sees chain-wide.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Links a staff login back to the Employee record it was created
  // from — null for the owner (who has no Employee record). Unique
  // since a login is 1:1 with the employee it belongs to.
  employeeId String?  @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otpCodes OtpCode[]

  approvedLeaveRequests LeaveRequest[] @relation("LeaveApprover")
  alertDismissals       AlertDismissal[]
  alertsTargetedToMe    Alert[]          @relation("AlertAudienceUser")

  // Leads this user personally created — see Lead.createdByUserId.
  createdLeads Lead[]

  @@map("users")
}

// One row per (organization, role, screen) — the editable permission
// matrix. Seeded true/true for Trainer/Manager/Front Desk across every
// Screen value when an organization is created (or lazily, on first
// staff login creation) so nothing needs to change when a new screen
// ships. The owner role bypasses this table entirely (always full
// access) rather than needing rows of its own.
model RolePermission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role   UserRole
  screen Screen

  canRead  Boolean @default(true)
  canWrite Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, role, screen])
  @@map("role_permissions")
}

model OtpCode {
  id      String     @id @default(cuid())
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose OtpPurpose
  channel OtpChannel
  code    String // 6-digit code, hashed would be stronger — see AuthService note

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@map("otp_codes")
}

// ---- Notifications ----
// Generic, extensible notification system — new types are just a new
// enum value + a trigger call site elsewhere, not new plumbing here.
// Config is org-level only for now (no per-branch override yet).

enum NotificationType {
  LEAD_OVERDUE
  LEAD_ASSIGNED
  // Not wired to anything yet — Employees/Members modules don't exist,
  // so these have nothing to check. The config rows exist so the
  // Configuration screen is ready ahead of time.
  BIRTHDAY_EMPLOYEE
  BIRTHDAY_MEMBER
  MEMBERSHIP_EXPIRY
}

enum NotificationSeverity {
  INFO
  WARNING
  URGENT
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type     NotificationType
  severity NotificationSeverity @default(INFO)

  title   String
  message String

  // What this notification is about, e.g. entityType "lead" + entityId
  // = a lead's id — lets the frontend jump straight to it.
  entityType String?
  entityId   String?

  // A stable, content-derived key used to stop the same event firing
  // twice (e.g. "lead-followup:<leadId>:<dueTime>:<offset>") — the
  // cron/trigger checks for an existing notification with this key
  // before creating another one. NOT what the bell dropdown groups by;
  // that grouping (Leads / Birthdays / Renewals) is done client-side
  // off the `type` field instead.
  groupKey String?

  read Boolean @default(false)

  // Manual dismiss — hides it from the active list without deleting.
  // Only meaningful once read (service enforces read-before-delete
  // rather than read-before-close, but both are "done with this").
  closedAt DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, groupKey])
  @@map("notifications")
}

// One row per organization — the master on/off switch. When disabled,
// the bell icon doesn't render at all on the frontend (not just empty).
model NotificationSetup {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  // Notifications older than this many days are permanently deleted by
  // a scheduled cleanup job. Null = never auto-clean.
  autoCleanDays Int?

  soundEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_setups")
}

// One row per (organization, type) — per-type rules, independent of
// the org-wide on/off switch above.
model NotificationConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type    NotificationType
  enabled Boolean              @default(true)
  severity NotificationSeverity @default(INFO)

  inAppEnabled    Boolean @default(true)
  // Stored now, not wired to anything yet — surfaced in the UI as
  // disabled "coming soon" toggles until an email/WhatsApp channel
  // actually exists.
  emailEnabled    Boolean @default(false)
  whatsappEnabled Boolean @default(false)

  // Flexible per-type rule, e.g. offsets before a target time:
  // { "offsets": [{ "value": 60, "unit": "MINUTES" }, { "value": 0, "unit": "MINUTES" }] }
  // Shape varies by type (minutes/hours for time-of-day events like a
  // lead follow-up, days for date-only events like membership expiry)
  // — kept as JSON so new types don't need a schema change.
  rule Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, type])
  @@map("notification_configs")
}

model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  category ExpenseCategory
  amount   Decimal @db.Decimal(10, 2)

  // When the expense was actually incurred (not when it was logged in
  // the system — those can differ, e.g. entering last week's electricity
  // bill today). Defaults to now() if the caller doesn't pass one.
  expenseDate DateTime @default(now())

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, branchId, expenseDate])
  @@map("expenses")
}

// ---------------------------------------------------------------------
// Leave management — self-service leave balance + apply/approve flow.
// LeaveAllocationConfig is the Owner-configured "how many days per
// month does each role get, per leave type" table; a scheduled job
// (LeaveAllocationCronService) credits every active employee's
// LeaveBalance from it on the 1st of each month, capped by
// carryForwardCap so unused balance doesn't grow unbounded.
// ---------------------------------------------------------------------

model LeaveAllocationConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Which non-owner role this row applies to (Branch Manager, Trainer,
  // Front Desk) — the Owner does not apply for leave through this
  // system, so OWNER/STAFF/MEMBER rows are never created here.
  role      UserRole
  leaveType LeaveType

  // Days credited on the 1st of every month for an active employee of
  // this role. Supports half-day increments (e.g. 1.5).
  monthlyAllocation Decimal @db.Decimal(4, 1)

  // Maximum balance an employee of this role/type can carry — the
  // monthly credit still runs, but the resulting balance is capped
  // here rather than growing indefinitely. Set equal to
  // monthlyAllocation for "no carry-forward" behavior.
  carryForwardCap Decimal @db.Decimal(4, 1)

  updatedAt DateTime @updatedAt

  @@unique([organizationId, role, leaveType])
  @@map("leave_allocation_configs")
}

model LeaveBalance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType
  balance   Decimal   @default(0) @db.Decimal(4, 1)

  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveType])
  @@map("leave_balances")
}

model LeaveRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  // Inclusive day count between startDate/endDate — computed and
  // stored at apply time rather than recalculated on every read.
  days      Decimal     @db.Decimal(4, 1)
  reason    String?
  status    LeaveStatus @default(PENDING)

  // The Branch Manager (or Owner, if the applicant is a Branch
  // Manager) who approved/rejected this request. Null while PENDING.
  approverUserId String?
  approverUser   User?   @relation("LeaveApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  decisionNote   String?
  decidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, branchId, status])
  @@index([employeeId, createdAt])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------
// Attendance — biometric device integration + derived daily records.
//
// Devices are heterogeneous across clients, so this is deliberately a
// thin, vendor-agnostic pipeline rather than one hard-coded protocol:
//
//   BiometricDevice  — one row per physical unit at a branch, tagged
//                       with how it talks to us (see BiometricVendorType).
//   BiometricEnrollment — maps a raw biometric user id (the PIN/UID a
//                       device reports) to an Employee or a Member.
//                       Enrollment itself (associating a fingerprint
//                       with a person) happens on the device/its own
//                       software — we only need to know which numeric
//                       id corresponds to which person here.
//   AttendancePunch  — one row per raw scan event, from any device
//                       type, before any interpretation.
//   AttendanceDayRecord — one row per employee per day, derived from
//                       that day's punches (+ approved leave + holidays)
//                       by AttendanceAggregationCronService. This is
//                       what the monthly summary and Dashboard read —
//                       never the raw punches directly.
//   Holiday          — org-wide dates excluded from absence tracking.
// ---------------------------------------------------------------------

enum BiometricVendorType {
  // Device pushes punches to us on its own over the internet, using the
  // ADMS/iClock protocol that ZKTeco and most same-firmware OEM clones
  // support natively (configured with our server URL on the device) —
  // the only path that's genuinely real-time with zero extra software.
  ADMS_PUSH
  // Any device/local bridge software that can make an HTTP POST with a
  // JSON body — a generic fallback for hardware without ADMS support.
  GENERIC_WEBHOOK
  // No push capability at all — punches are exported from the device's
  // own software and uploaded here as a CSV on a schedule the client
  // controls.
  CSV_IMPORT
}

enum PunchPersonType {
  EMPLOYEE
  MEMBER
}

enum PunchDirection {
  IN
  OUT
  UNKNOWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

model BiometricDevice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name       String
  vendorType BiometricVendorType

  // The device's own serial number — how an ADMS push identifies which
  // device it's from (the ?SN= query param on every request). Required
  // and unique per org for ADMS_PUSH devices; optional/unused for the
  // other vendor types.
  serialNumber String?

  // Bearer token a GENERIC_WEBHOOK caller (or CSV import) must present
  // — generated on device creation, rotatable. Not used by ADMS_PUSH
  // devices, which authenticate by serial number instead (the real
  // protocol has no better option — see AttendanceIngestController).
  apiKey String @unique @default(cuid())

  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments BiometricEnrollment[]
  punches     AttendancePunch[]

  @@unique([organizationId, serialNumber])
  @@map("biometric_devices")
}

model BiometricEnrollment {
  id             String @id @default(cuid())
  organizationId String

  deviceId String
  device   BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // The raw id the device reports for this person (its "PIN"/UID) —
  // meaningful only in combination with deviceId, since two different
  // devices can reuse the same small integer for different people.
  biometricUserId String

  personType PunchPersonType
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  memberId   String?
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([deviceId, biometricUserId])
  @@map("biometric_enrollments")
}

model AttendancePunch {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  deviceId String
  device   BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  biometricUserId String
  personType      PunchPersonType

  // Resolved from BiometricEnrollment at ingestion time — null if the
  // device reported a biometricUserId with no enrollment on file yet
  // (surfaced as an "unmatched punch" for the Owner to enroll).
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  memberId   String?
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  punchTime DateTime
  direction PunchDirection @default(UNKNOWN)

  // The raw line/payload as received, kept for debugging a device
  // that's sending unexpected data — never parsed back out.
  raw String?

  createdAt DateTime @default(now())

  @@index([organizationId, branchId, punchTime])
  @@index([employeeId, punchTime])
  @@index([memberId, punchTime])
  @@map("attendance_punches")
}

model AttendanceDayRecord {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Stored at midnight UTC for the calendar day it summarizes.
  date   DateTime
  status AttendanceStatus

  firstPunchAt DateTime?
  lastPunchAt  DateTime?

  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@map("attendance_day_records")
}

model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  date DateTime
  name String

  createdAt DateTime @default(now())

  @@unique([organizationId, date])
  @@map("holidays")
}


// ---- Login alerts ----
// Owner-configured notices shown right after login. A valid window
// (startDate mandatory, endDate optional — an open-ended alert stays
// active until the Owner manually flips isActive off) plus a per-user
// "don't show again" opt-out (AlertDismissal) rather than a single
// global dismissal, since one person snoozing a notice shouldn't hide
// it from everyone else who hasn't seen it yet.
enum AlertAudienceType {
  ALL
  BRANCH
  USER
}

model Alert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title   String
  message String

  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)

  // Who sees this alert. ALL (default) = everyone in the org. BRANCH =
  // only logins scoped to audienceBranchId. USER = only the one login
  // at audienceUserId. Exactly one of the two ID fields is set,
  // matching audienceType — enforced in the service, not the schema.
  audienceType     AlertAudienceType @default(ALL)
  audienceBranchId String?
  audienceBranch   Branch?           @relation("AlertAudienceBranch", fields: [audienceBranchId], references: [id], onDelete: Cascade)
  audienceUserId   String?
  audienceUser     User?             @relation("AlertAudienceUser", fields: [audienceUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dismissals AlertDismissal[]

  @@index([organizationId, isActive])
  @@map("alerts")
}

model AlertDismissal {
  id String @id @default(cuid())

  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dismissedAt DateTime @default(now())

  @@unique([alertId, userId])
  @@map("alert_dismissals")
}
