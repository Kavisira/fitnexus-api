# Copy this to .env and fill in real values. Never commit the real .env.

DATABASE_URL=
JWT_SECRET=
CORS_ORIGINS=http://localhost:4200
PORT=3000

# S3-compatible storage for member progress photos (see
# src/uploads/s3.service.ts). This project uses Supabase Storage's S3
# endpoint rather than real AWS S3 — get the access key ID/secret from
# Supabase dashboard -> Project Settings -> Storage -> S3 Connection
# (this generates its own keypair, separate from your Supabase service
# role key). Mark the bucket "Public" in Storage settings so uploaded
# photos are readable without a signed URL.
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="fitnexus"
AWS_ACCESS_KEY_ID="5fe69bd4f9aa826c7c05ae4d4add4924"
AWS_SECRET_ACCESS_KEY="f6120c4f8c625a2cf34d7b1769662a6f5bc0770cea790f23b9dba876dc3ba771"
# Supabase's S3-compatible upload endpoint (from the same S3 Connection
# panel) — setting this switches the client into path-style mode.
AWS_S3_ENDPOINT=https://cyqyoauwehtddgtdfvlg.storage.supabase.co/storage/v1/s3
# Where PUBLIC reads are actually served from — a different host/path
# than the endpoint above. <project-ref> is the same ref as your
# Supabase project URL (the cyqyoauwehtddgtdfvlg part).
AWS_S3_PUBLIC_BASE_URL=https://cyqyoauwehtddgtdfvlg.storage.supabase.co/storage/v1/s3

# --- Real AWS S3 instead of Supabase Storage? ---
# Leave AWS_S3_ENDPOINT and AWS_S3_PUBLIC_BASE_URL blank, set a real
# AWS_REGION (e.g. ap-south-1) and an AWS IAM access key/secret with
# s3:PutObject on the bucket. The public URL then defaults to
# https://<bucket>.s3.<region>.amazonaws.com automatically.
