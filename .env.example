# Copy this to .env and fill in real values. Never commit the real .env.

DATABASE_URL=
JWT_SECRET=
CORS_ORIGINS=http://localhost:4200
PORT=3000

# S3-compatible storage for member progress photos (see
# src/uploads/s3.service.ts). This project uses Supabase Storage's S3
# endpoint rather than real AWS S3 — get the access key ID/secret from
# Supabase dashboard -> Project Settings -> Storage -> S3 Connection
# (this generates its own keypair, separate from your Supabase service
# role key). Mark the bucket "Public" in Storage settings so uploaded
# photos are readable without a signed URL.
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="fitnexus"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Supabase's S3-compatible upload endpoint (from the same S3 Connection
# panel) — setting this switches the client into path-style mode.
AWS_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# Where PUBLIC reads are actually served from — a DIFFERENT host/path
# than the endpoint above (note "object/public", not "s3"). <project-ref>
# is the same ref as your Supabase project URL.
AWS_S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public

# --- Real AWS S3 instead of Supabase Storage? ---
# Leave AWS_S3_ENDPOINT and AWS_S3_PUBLIC_BASE_URL blank, set a real
# AWS_REGION (e.g. ap-south-1) and an AWS IAM access key/secret with
# s3:PutObject on the bucket. The public URL then defaults to
# https://<bucket>.s3.<region>.amazonaws.com automatically.

# Meta WhatsApp Cloud API — direct integration, no BSP (see
# src/whatsapp/whatsapp.service.ts). WHATSAPP_ACCESS_TOKEN is a System
# User permanent token from Meta Business Manager (not a 24h test
# token); WHATSAPP_PHONE_NUMBER_ID is the Phone Number ID (not the
# WhatsApp Business Account ID) from WhatsApp Manager > API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Override only if your approved template names differ from the defaults
# baked into WhatsappService (otp_code / leave_decision / payslip_ready).
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_LEAVE_DECISION=
WHATSAPP_TEMPLATE_PAYSLIP_READY=

# Resend (email, used by EmailService — EMAIL-channel OTP + notification dispatch)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Shared WhatsApp template for all NotificationsService.notify() dispatches
# (lead assignment/overdue, birthday wishes, membership expiry reminders).
# Separate from the OTP/leave/payslip templates in whatsapp.service.ts.
WHATSAPP_TEMPLATE_GENERIC=

# Base URL of the deployed Angular frontend (no trailing slash) — used
# to build public share links (forms, member diet/workout pages) that
# get sent over WhatsApp/QR. e.g. https://myfitnexusapp.com
FRONTEND_PUBLIC_URL=
