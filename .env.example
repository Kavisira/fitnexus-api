# Postgres connection string — for local dev, point this at a free
# Supabase/Neon/Railway Postgres instance (see the "Tech Stack & Free
# Deployment Plan" doc). Prisma reads this.
DATABASE_URL="postgresql://user:password@localhost:5432/fitnexus?schema=public"

# Used to sign JWTs issued on login. Generate a real random secret for
# anything beyond local dev, e.g.: openssl rand -base64 48
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Port the Nest app listens on.
PORT=3000

# Comma-separated list of origins allowed to call this API (the Angular
# dev server by default).
CORS_ORIGINS="http://localhost:4200"
